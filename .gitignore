# Build output.
# contracts/ and aqua/ carry their own upstream .gitignore for out/cache/artifacts/
# node_modules, so do NOT blanket-ignore here: contracts/broadcast/ holds 43
# upstream-committed deployment records that are part of the pinned tree.
node_modules/
reference/dodo/out/
reference/dodo/cache/

# Our own anvil runs: keep run-latest.json as evidence, drop the timestamped copies.
contracts/broadcast/SmokeSwapLocal.s.sol/*/run-[0-9]*.json
